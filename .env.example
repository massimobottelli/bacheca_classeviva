# ── ClasseViva ────────────────────────────────────────────────────────────────
# Credenziali di accesso al registro (obbligatorie)
CV_UID=nome.cognome
CV_PASSWORD=qui-la-tua-password
# Codice scuola e PIN: lasciare vuoti se non richiesti dal login
CV_CID=
CV_PIN=

# Se true, l'agente chiama l'endpoint "read" che recupera il testo dell'avviso
# MA lo segna anche come letto sul registro. Default false (non tocca lo stato).
# Con false, la sintesi si basa su titolo/metadati + testo degli allegati PDF.
MARK_AS_READ=false

# ── Telegram ──────────────────────────────────────────────────────────────────
# Token del bot creato con @BotFather (obbligatorio)
TG_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Chat ID: avvia una chat con il tuo bot (comando /start) e leggi
# https://api.telegram.org/bot<TOKEN>/getUpdates
TG_CHAT_ID=123456789

# ── Sintesi LLM (opzionale) ──────────────────────────────────────────────────
# Endpoint compatibile OpenAI chat/completions. Esempi:
#   OpenAI:    https://api.openai.com/v1/chat/completions
#   Claude:    https://api.anthropic.com/v1/chat/completions
#   Gemini:    https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   Ollama:    http://localhost:11434/v1/chat/completions
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# ── Comportamento ─────────────────────────────────────────────────────────────
# Giorni di storico da considerare alla prima esecuzione (evita di processare
# tutto l'archivio della bacheca). Default 7.
BACKFILL_DAYS=7
# Pausa in secondi tra una richiesta HTTP e la successiva (API non ufficiale:
# usa solo per scopi personali e non martellare il server). Default 1.
REQUEST_DELAY=1